        <item>با دووباره‌ چه‌مانه‌وه‌ی کات بکه‌ینه‌وه‌.</item>
        <item>ته‌نیا بازبده‌ بۆ به‌جێهێشتن.</item>
        <item>تۆ پالێتت هه‌یه‌ بۆ خێرایی.</item>
        <item>ته‌قاندنه‌وه‌ی فۆتۆن.</item>
    </string-array>
</resources>
